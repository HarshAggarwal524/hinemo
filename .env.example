# Copy this file to .env and fill in your real values.
# Never commit .env itself — it's already in .gitignore.

# Reddit API (free) — get these at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=HinEmoResearchCollector/1.0 (by u/YOUR_USERNAME)

# OpenAI (for GPT-4o-mini emotion labeling)
OPENAI_API_KEY=

# Twitter gateway (only needed if/when you use the paid top-up script)
TWITTER_GATEWAY_API_KEY=


YOUTUBE_API_KEY=